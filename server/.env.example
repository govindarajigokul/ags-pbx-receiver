PORT=3000
# Mount a persistent volume here: recordings + index.jsonl live in it
DATA_DIR=/data
# One entry per PBX: <source-name>:<long-random-token>, comma separated
PBX_TOKENS=ags-resort1:CHANGE_ME_LONG_RANDOM
# For listing / downloading recordings (future AGS app, or you via curl)
ADMIN_TOKEN=CHANGE_ME_ANOTHER_LONG_RANDOM
MAX_BYTES=26214400
